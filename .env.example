# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_BLOB_CONTAINER=simsasukgo

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=

# 외부 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
LAWSUIT_API_KEY=

# Anthropic (재무 분석 Agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=8192
FINANCIAL_SAMPLES_BLOB_PREFIX=templates/financial_samples/

# 보고서 작성 Agent (Claude — 글빨 위해 sonnet 권장)
REPORT_MODEL=claude-sonnet-4-6
REPORT_MAX_TOKENS=8192
REPORT_SAS_EXPIRY_HOURS=168
REPORT_SAMPLES_BLOB_PREFIX=templates/report_samples/

# 보고서 PR4 폴리싱
REPORT_BASE_DOCX_BLOB_PATH=
APPENDIX_ROW_THRESHOLD=35

# 이미지 caption용 Vision (default off — 비용 0)
IMAGE_VISION_ENABLED=false
IMAGE_VISION_MODEL=claude-haiku-4-5-20251001

# Gmail (모니터링 알림)
GMAIL_CREDENTIALS_BLOB_PATH=credentials/gmail_oauth.json
GMAIL_SENDER_ADDRESS=

# 모니터링 알림 트리거
ALERT_MIN_RISK_LEVEL=MEDIUM
ALERT_DEDUP_DAYS=90
ALERT_FIRST_RUN_SEND=true

# 모니터링 스케줄러 (APScheduler)
MONITORING_BATCH_CRON=0 9 1 */3 *
MONITORING_CATCHUP_THRESHOLD_DAYS=90
MONITORING_SCHEDULER_ENABLED=true

# MCP 서버
MCP_HOST=0.0.0.0
MCP_PORT=8000

# 로깅
LOG_LEVEL=INFO
LOG_FORMAT=json
